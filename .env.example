# ============================================================================
# .env.example — copy this file to .env and fill in YOUR OWN values
#
#   cp .env.example .env
#
# The .env file is git-ignored. NEVER commit real credentials.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. Telegram Bot (from @BotFather on Telegram)
# ---------------------------------------------------------------------------
# Message @BotFather -> /newbot -> it gives you a token like 123456789:ABCdef...
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Your numeric Telegram user ID (message @userinfobot to get it)
# Comma-separated for multiple users: 123456789,987654321
TELEGRAM_ALLOWED_USERS=your_numeric_user_id

# ---------------------------------------------------------------------------
# 2. Gmail (IMAP) — use an App Password, NOT your normal password
# ---------------------------------------------------------------------------
# 1. Enable 2FA at https://myaccount.google.com/security
# 2. Create an app password at https://myaccount.google.com/apppasswords
# 3. Paste it here (spaces are fine: "abcd efgh ijkl mnop")
EMAIL_ADDRESS=your.email@gmail.com
EMAIL_PASSWORD=your_16_char_gmail_app_password

# IMAP / SMTP (defaults shown — Gmail)
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Who may interact with the agent via email (comma-separated)
EMAIL_ALLOWED_USERS=your.email@gmail.com
EMAIL_HOME_ADDRESS=your.email@gmail.com

# ---------------------------------------------------------------------------
# 3. DeepSeek API (the LLM brain)
# ---------------------------------------------------------------------------
# Get a key at https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# 4. Optional — scheduled email summaries (Hermes cron)
# ---------------------------------------------------------------------------
# 5-field cron: minute hour day-of-month month day-of-week
# "0 9,18 * * *" = every day at 09:00 and 18:00
EMAIL_SUMMARY_CRON=0 9,18 * * *
